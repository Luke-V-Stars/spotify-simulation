# Copy this file to .env and replace the placeholders with your Spotify app's values.
# Create the app at https://developer.spotify.com/dashboard
# These values are only ever read by the Node server. They are never sent to the browser.

SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# Must exactly match a Redirect URI registered in the Spotify dashboard.
# Spotify rejects "localhost": use 127.0.0.1 for local development, HTTPS everywhere else.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/auth/callback
